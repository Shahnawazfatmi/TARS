# Copy to backend/.env and set up at least one model.
# The local model is used first; Gemini is the fallback when it fails.
# Local model server with an OpenAI-style API (llama.cpp, vLLM, Ollama).
# Model name = the "id" listed at <url>/models.
FATMEE_LOCAL_LLM_URL=http://your-server:8080/v1
FATMEE_LOCAL_LLM_MODEL=your-model-name
# Gemini: fallback for text, and the default for images.
GEMINI_API_KEY=your-gemini-api-key
# OpenAI is optional: add it to FATMEE_LLM_PROVIDERS / FATMEE_IMAGE_PROVIDERS to use it.
# OPENAI_API_KEY=your-openai-api-key

# Web search for the research agent (tavily.com). Without it FATMEE
# still runs; research answers that search is not set up.
TAVILY_API_KEY=your-tavily-api-key

# LinkedIn (FATMEE's own LinkedIn MCP server, official API). From your app
# at https://www.linkedin.com/developers/apps -> Auth tab. Then open
# http://127.0.0.1:8000/linkedin/connect once to log in.
# LINKEDIN_CLIENT_ID=your-linkedin-client-id
# LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
# Must match the Authorized redirect URL in your LinkedIn app exactly.
# LINKEDIN_REDIRECT_URI=http://127.0.0.1:8000/linkedin/callback
# true (default) = check everything, publish nothing. false = really post.
# FATMEE_LINKEDIN_DRY_RUN=true
# LinkedIn API version (YYYYMM); update when LinkedIn retires it.
# FATMEE_LINKEDIN_VERSION=202609

# Optional settings
# FATMEE_LLM_PROVIDERS=local,gemini
# FATMEE_LOCAL_LLM_API_KEY=not-needed
# FATMEE_LOCAL_LLM_THINKING=false
# FATMEE_LOCAL_LLM_TIMEOUT=180
# FATMEE_OPENAI_MODEL=gpt-5.4-mini
# FATMEE_GEMINI_MODEL=gemini-3.6-flash
# FATMEE_LLM_TIMEOUT=60
# FATMEE_GOAL_CHECK=true
# FATMEE_TOOL_WORKERS=8
# FATMEE_LOG_LEVEL=INFO
# FATMEE_MCP_TIMEOUT=30
# FATMEE_RESEARCH_SOURCES=5
# FATMEE_DOCUMENTS_DIR=
# FATMEE_IMAGE_PROVIDERS=gemini
# FATMEE_OPENAI_IMAGE_MODEL=gpt-image-1-mini
# FATMEE_OPENAI_IMAGE_QUALITY=medium
# FATMEE_GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# FATMEE_IMAGE_DEFAULT_STYLE=photo
# FATMEE_IMAGES_DIR=
# FATMEE_MAX_IMAGES_PER_TASK=1

# Task logs (backend/logs/tasks.jsonl); false switches them off
# FATMEE_TASK_LOG=true
# FATMEE_TASK_LOG_DIR=
# FATMEE_TASK_LOG_MAX_CHARS=2000
# FATMEE_TASK_LOG_RESPONSE_CHARS=8000
# Optional, for cost estimates: USD per 1M tokens, from your provider's
# price page. Not set = costs are logged as null, never guessed.
# FATMEE_LLM_PRICES={"gpt-5.4-mini": {"input": 0.25, "output": 2.0}}
